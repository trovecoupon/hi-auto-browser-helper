{
  "manifest_version": 3,
  "name": "Hi Auto Browser Helper",
  "short_name": "Hi Auto Helper",
  "version": "3.0.0",
  "description": "Hi Auto side-panel assistant for Ads Discovery, coupons, Keyword Planner, and affiliate applications.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage", "tabs", "sidePanel", "scripting", "downloads", "offscreen", "alarms"],
  "optional_permissions": ["clipboardRead"],
  "host_permissions": [
    "http://127.0.0.1:8770/*",
    "http://localhost:8770/*",
    "http://127.0.0.1:8771/*",
    "https://hi-auto.vercel.app/*",
    "https://valentin.app/*",
    "https://www.google.com/*",
    "https://ads.google.com/*",
    "https://sitedata.dev/*",
    "https://adstransparency.google.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": {
    "default_title": "Hi Auto Browser Helper",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "side_panel": { "default_path": "sidepanel/panel.html" },
  "options_page": "options/options.html",
  "content_scripts": [
    { "matches": ["http://127.0.0.1:8770/*", "http://localhost:8770/*", "https://hi-auto.vercel.app/*"], "js": ["content/local-app.js"], "run_at": "document_idle" },
    { "matches": ["https://valentin.app/*"], "js": ["content/valentin.js"], "run_at": "document_idle" },
    { "matches": ["https://www.google.com/search*"], "js": ["content/serp.js"], "run_at": "document_idle" },
    { "matches": ["https://www.google.com/search*"], "js": ["content/coupon-serp.js"], "run_at": "document_idle" },
    { "matches": ["https://adstransparency.google.com/*"], "js": ["content/ads-transparency.js"], "run_at": "document_idle" },
    { "matches": ["https://ads.google.com/*"], "js": ["content/keyword-planner.js"], "run_at": "document_idle" },
    { "matches": ["https://www.google.com/*"], "js": ["content/google-ad-frame.js"], "run_at": "document_idle", "all_frames": true }
  ],
  "web_accessible_resources": [{ "resources": ["lib/parsers.mjs", "lib/live-dom.mjs", "lib/frame-coordinator.mjs", "lib/job-orchestrator.mjs", "lib/serp-pacing.mjs", "lib/autocomplete-orchestrator.mjs", "lib/adapter-registry.mjs", "lib/coupon-codes.mjs", "lib/coupon-queries.mjs", "lib/coupon-parsers.mjs", "lib/coupon-job-runner.mjs", "lib/keyword-planner.mjs", "lib/form-assistant.mjs", "content/shared.js", "content/overlay.css"], "matches": ["<all_urls>"] }]
}
